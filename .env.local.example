# ── wall-api ─────────────────────────────────────────────────────────────────
# The Cloud Run service in the poddster-wall repo. This app never talks to
# GCP directly — everything GCS/Cloud Run related goes through wall-api.
WALL_API_URL=https://wall-api-oojomabpjq-as.a.run.app
# Shared secret — same value as the `wall-internal-api-key` secret in GCP
# Secret Manager (project arwconverter). Get it with:
#   gcloud secrets versions access latest --secret=wall-internal-api-key --project=arwconverter
INTERNAL_API_KEY=your-shared-secret-here
